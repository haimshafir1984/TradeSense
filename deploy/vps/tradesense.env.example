# Copy the secret values from the Render dashboard (Environment tab). Never commit this file.
NODE_ENV=production
PORT=4000
APP_DOMAIN=__DOMAIN__
CLIENT_ORIGIN=https://__DOMAIN__
AUTOPILOT_DB_PATH=/var/lib/tradesense/autopilot.sqlite
PORTFOLIO_STORE_FILE_PATH=/var/lib/tradesense/portfolio.json
DATA_MODE=fmp
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
FINNHUB_API_KEY=
PUSH_CONTACT=mailto:you@example.com
AUTOPILOT_SCAN_PROFILE=balanced
AUTOPILOT_SIP_CONTEXT_MODE=shadow
